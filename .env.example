# Anthropic API Key — obtenha em https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Modelo Claude a usar (recomendado: claude-opus-4-7 ou claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Senha de acesso ao painel admin
ADMIN_SECRET_TOKEN=troque-para-uma-string-segura

# Banco de dados (SQLite por padrão; use PostgreSQL em produção)
DATABASE_URL=sqlite:///./sentinela.db

# Nome da aplicação exibido na UI
APP_NAME=Sentinela

# Ambiente (development | production)
APP_ENV=development

# Região AWS padrão
AWS_DEFAULT_REGION=us-east-1

# Perfil AWS local para desenvolvimento (deixe em branco em produção)
# FINOPS_AWS_PROFILE=meu-perfil

# Cognito OIDC — opcional, para autenticação corporativa em produção
# COGNITO_CLIENT_ID=
# COGNITO_CLIENT_SECRET=
# COGNITO_DOMAIN=
# COGNITO_REDIRECT_URI=https://sentinela.yourdomain.com/admin/auth/callback

# ─── Branding (optional, customize for your consultancy) ─────────────────
# Deixe CONSULTANCY_NAME vazio para o produto sair sem branding de consultoria.
CONSULTANCY_NAME=
PRODUCT_NAME=Cloud Sentinel
PRIMARY_COLOR_HEX=#FF679A
ACCENT_COLOR_HEX=#0B1956
# Caminho absoluto para um PNG. Em K8s, monte via volume/ConfigMap.
LOGO_PATH=
# Palavras proibidas na saída do LLM (CSV). Validação será adicionada no Sprint #2.
BRAND_BLOCKLIST=dreamsquad,dream squad
